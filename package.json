{
  "name": "@blitzreels/eve",
  "version": "0.2.2",
  "description": "eve extension that gives durable AI agents BlitzReels video editing, clipping, generation, and export tools.",
  "homepage": "https://blitzreels.com/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blitzreels/eve-extension.git"
  },
  "bugs": {
    "url": "https://github.com/blitzreels/eve-extension/issues"
  },
  "type": "module",
  "keywords": [
    "eve",
    "eve-extension",
    "blitzreels",
    "video",
    "agent"
  ],
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "scripts": {
    "build": "eve extension build",
    "check:boundary": "node scripts/check-boundary.mjs",
    "lint": "biome check .",
    "prepublishOnly": "pnpm verify",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm check:boundary && pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@blitzreels/sdk": "^0.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.0.0",
    "eve": "0.27.5",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eve": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.16.0"
}
